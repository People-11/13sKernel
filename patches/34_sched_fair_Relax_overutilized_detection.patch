From babd4a6975392e5827920250502579f61c730870 Mon Sep 17 00:00:00 2001
From: brokestar233 <3765589194@qq.com>
Date: Wed, 4 Feb 2026 21:57:06 +0800
Subject: [PATCH] sched/fair: Relax overutilized detection with threshold
 mechanism

The current overutilized detection logic is too aggressive for modern
heterogeneous SoCs, specifically those with "all-big" core architectures
(e.g., Snapdragon 8 Elite / SM8750).

Currently, the root domain is flagged as overutilized (disabling EAS)
instantaneously if a *single* CPU crosses the utilization threshold. This
occurs even during micro-bursts or when a single heavy thread runs on a
CPU. On an 8-core system with powerful mid-cores, this premature fallback
to global load balancing (SMP) ignores the capacity of the remaining
idle/underutilized cores, leading to suboptimal energy efficiency and
unnecessary task migrations.

This patch introduces a threshold-based overutilized detection mechanism:

1. Remove the high-frequency checks in enqueue_task_fair() and
   task_tick_fair(). The state is now only updated during the periodic
   load balance path, providing natural debouncing.

2. Introduce a counter 'nr_overutilized' in sg_lb_stats to track the
   number of overutilized CPUs per group and aggregate it at the
   domain level.

3. Redefine the root domain overutilized state: The system is considered
   overutilized only if more than 50% of the CPUs in the sched domain
   are overutilized (threshold = span_weight / 2).

For a 2+6 architecture (2 Prime + 6 Performance cores), this ensures
EAS remains active even if the Prime cores and some Performance cores
are saturated, provided there is still capacity in the remaining cores
to absorb tasks.

Change-Id: Ic8933e9d3762ee9eef73ab57b79ac270b8edc2cf
Signed-off-by: brokestar233 <3765589194@qq.com>
---
 kernel/sched/fair.c | 36 +++++++++++++-----------------------
 1 file changed, 13 insertions(+), 23 deletions(-)

Index: common/kernel/sched/fair.c
===================================================================
--- common/kernel/sched/fair.c
+++ common/kernel/sched/fair.c
@@ -6733,21 +6733,6 @@ static inline void set_rd_overutilized_s
 	WRITE_ONCE(rd->overutilized, status);
 	trace_sched_overutilized_tp(rd, !!status);
 }
-
-static inline void check_update_overutilized_status(struct rq *rq)
-{
-	/*
-	 * overutilized field is used for load balancing decisions only
-	 * if energy aware scheduler is being used
-	 */
-	if (!sched_energy_enabled())
-		return;
-
-	if (!READ_ONCE(rq->rd->overutilized) && cpu_overutilized(rq->cpu))
-		set_rd_overutilized_status(rq->rd, SG_OVERUTILIZED);
-}
-#else
-static inline void check_update_overutilized_status(struct rq *rq) { }
 #endif
 
 /* Runqueue only has SCHED_IDLE tasks enqueued */
@@ -6775,7 +6760,6 @@ enqueue_task_fair(struct rq *rq, struct
 	struct cfs_rq *cfs_rq;
 	struct sched_entity *se = &p->se;
 	int idle_h_nr_running = task_has_idle_policy(p);
-	int task_new = !(flags & ENQUEUE_WAKEUP);
 	int should_iowait_boost;
 
 	/*
@@ -6851,8 +6835,6 @@ enqueue_task_fair(struct rq *rq, struct
 	 * into account, but that is not straightforward to implement,
 	 * and the following generally works well enough in practice.
 	 */
-	if (!task_new)
-		check_update_overutilized_status(rq);
 
 enqueue_throttle:
 	assert_list_leaf_cfs_rq(rq);
@@ -9579,6 +9561,7 @@ struct sg_lb_stats {
 	unsigned int nr_numa_running;
 	unsigned int nr_preferred_running;
 #endif
+	unsigned int nr_overutilized; 
 };
 
 /*
@@ -10031,8 +10014,10 @@ static inline void update_sg_lb_stats(st
 		nr_running = rq->nr_running;
 		sgs->sum_nr_running += nr_running;
 
-		if (cpu_overutilized(i))
+		if (cpu_overutilized(i)) {
 			*sg_status |= SG_OVERUTILIZED;
+			sgs->nr_overutilized++;
+		}
 
 		/*
 		 * No need to call idle_cpu() if nr_running is not 0
@@ -10702,6 +10687,7 @@ static inline void update_sd_lb_stats(st
 	struct sg_lb_stats *local = &sds->local_stat;
 	struct sg_lb_stats tmp_sgs;
 	unsigned long sum_util = 0;
+	unsigned int domain_overutilized_cnt = 0;
 	int sg_status = 0;
 
 	do {
@@ -10720,6 +10706,8 @@ static inline void update_sd_lb_stats(st
 
 		update_sg_lb_stats(env, sds, sg, sgs, &sg_status);
 
+		domain_overutilized_cnt += sgs->nr_overutilized;
+
 		if (!local_group && update_sd_pick_busiest(env, sds, sg, sgs)) {
 			sds->busiest = sg;
 			sds->busiest_stat = *sgs;
@@ -10748,10 +10736,13 @@ static inline void update_sd_lb_stats(st
 	if (!env->sd->parent) {
 		/* update overload indicator if we are at root domain */
 		WRITE_ONCE(env->dst_rq->rd->overload, sg_status & SG_OVERLOAD);
+		int threshold = env->sd->span_weight >> 1; 
+
+		if (domain_overutilized_cnt > threshold)
+			set_rd_overutilized_status(env->dst_rq->rd, SG_OVERUTILIZED);
+		else
+			set_rd_overutilized_status(env->dst_rq->rd, 0);
 
-		/* Update over-utilization (tipping point, U >= 0) indicator */
-		set_rd_overutilized_status(env->dst_rq->rd,
-					   sg_status & SG_OVERUTILIZED);
 	} else if (sg_status & SG_OVERUTILIZED) {
 		set_rd_overutilized_status(env->dst_rq->rd, SG_OVERUTILIZED);
 	}
@@ -12750,7 +12741,6 @@ static void task_tick_fair(struct rq *rq
 		task_tick_numa(rq, curr);
 
 	update_misfit_status(curr, rq);
-	check_update_overutilized_status(task_rq(curr));
 
 	task_tick_core(rq, curr);
 }
