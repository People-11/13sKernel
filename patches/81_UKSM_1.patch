From: =?UTF-8?q?=E9=98=BF=E8=8F=8C=E2=80=A2=E6=9C=AA=E9=9C=9C?=
 <799620521@qq.com>
Date: Thu, 2 Mar 2023 11:54:03 +0800
Subject: [PATCH] mm: uksm: Allow set default CPU governor

---
 mm/Kconfig | 14 ++++++++++++++
 mm/uksm.c  |  2 +-
 2 files changed, 15 insertions(+), 1 deletion(-)

Index: common/mm/Kconfig
===================================================================
--- common/mm/Kconfig	2025-10-28 14:40:33.064236119 +1030
+++ common/mm/Kconfig	2025-10-28 14:40:33.060569453 +1030
@@ -795,6 +795,20 @@
 	The legacy KSM implementation from Red Hat.
 endchoice
 
+if UKSM
+
+config UKSM_CPU_GOVERNOR
+	int "Ultra-KSM default CPU governor"
+	range 0 3
+	help
+	The UKSM default CPU governor.
+	0: full
+	1: medium
+	2: low
+	3: quiet
+
+endif
+
 config DEFAULT_MMAP_MIN_ADDR
 	int "Low address space to protect from user allocation"
 	depends on MMU
Index: common/mm/uksm.c
===================================================================
--- common/mm/uksm.c	2025-10-28 14:40:33.064236119 +1030
+++ common/mm/uksm.c	2025-10-28 14:40:33.060569453 +1030
@@ -525,7 +525,7 @@
 /* Max percentage of cpu utilization ksmd can take to scan in one batch */
 static unsigned int uksm_max_cpu_percentage;
 
-static int uksm_cpu_governor;
+static int uksm_cpu_governor = CONFIG_UKSM_CPU_GOVERNOR;
 
 static char *uksm_cpu_governor_str[4] = { "full", "medium", "low", "quiet" };
 
