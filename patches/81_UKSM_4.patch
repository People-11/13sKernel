From 452b7687e3c3ee921ed6168e6eec856ddea3e2aa Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=E9=98=BF=E8=8F=8C=E2=80=A2=E6=9C=AA=E9=9C=9C?=
 <799620521@qq.com>
Date: Thu, 2 Mar 2023 12:29:35 +0800
Subject: [PATCH] mm: uksm: Add android optimized preset

---
 mm/Kconfig |  3 ++-
 mm/uksm.c  | 19 +++++++++++++++++--
 2 files changed, 19 insertions(+), 3 deletions(-)

Index: common/mm/Kconfig
===================================================================
--- common/mm/Kconfig	2025-11-01 01:23:12.087025773 +1030
+++ common/mm/Kconfig	2025-11-01 01:23:12.079362762 +1030
@@ -799,13 +799,14 @@
 
 config UKSM_CPU_GOVERNOR
 	int "Ultra-KSM default CPU governor"
-	range 0 3
+	range 0 4
 	help
 	The UKSM default CPU governor.
 	0: full
 	1: medium
 	2: low
 	3: quiet
+	4: android
 
 endif
 
Index: common/mm/uksm.c
===================================================================
--- common/mm/uksm.c	2025-11-01 01:23:12.087025773 +1030
+++ common/mm/uksm.c	2025-11-01 01:23:12.087025773 +1030
@@ -527,7 +527,7 @@
 
 static int uksm_cpu_governor = CONFIG_UKSM_CPU_GOVERNOR;
 
-static char *uksm_cpu_governor_str[4] = { "full", "medium", "low", "quiet" };
+static char *uksm_cpu_governor_str[5] = { "full", "medium", "low", "quiet", "android" };
 
 struct uksm_cpu_preset_s {
 	int cpu_ratio[SCAN_LADDER_SIZE];
@@ -535,7 +535,7 @@
 	unsigned int max_cpu; /* percentage */
 };
 
-struct uksm_cpu_preset_s uksm_cpu_preset[4] = {
+struct uksm_cpu_preset_s uksm_cpu_preset[5] = {
 	{
 		{
 			20,
@@ -596,6 +596,21 @@
 		},
 		1
 	},
+	{
+		{
+			100,
+			-TIME_RATIO_SCALE / 10,
+			-TIME_RATIO_SCALE / 2,
+			-TIME_RATIO_SCALE
+		},
+		{
+			1000,
+			500,
+			200,
+			50
+		},
+		90
+	},
 };
 
 /* The default value for uksm_ema_page_time if it's not initialized */
