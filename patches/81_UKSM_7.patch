From 4092cf3b1b2b2104fec441199d1975a5f0a775ab Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=E9=98=BF=E8=8F=8C=E2=80=A2=E6=9C=AA=E9=9C=9C?=
 <799620521@qq.com>
Date: Mon, 6 Mar 2023 17:37:37 +0800
Subject: [PATCH] mm: uksm: Allow set max UKSM sleep time to 60s

---
 mm/Kconfig | 4 ++++
 mm/uksm.c  | 8 ++++----
 2 files changed, 8 insertions(+), 4 deletions(-)

Index: common/mm/Kconfig
===================================================================
--- common/mm/Kconfig	2025-10-28 14:40:33.606902795 +1030
+++ common/mm/Kconfig	2025-10-28 14:40:33.603236127 +1030
@@ -808,6 +808,10 @@
 	3: quiet
 	4: android
 
+config UKSM_SLEEP_MS
+	int "Ultra-KSM default sleep millisecs"
+	range 8 60000
+
 endif
 
 config DEFAULT_MMAP_MIN_ADDR
Index: common/mm/uksm.c
===================================================================
--- common/mm/uksm.c	2025-10-28 14:40:33.606902795 +1030
+++ common/mm/uksm.c	2025-10-28 14:40:33.603236127 +1030
@@ -4842,8 +4842,8 @@
 		if (expected_jiffies > uksm_sleep_real)
 			uksm_sleep_real = expected_jiffies;
 
-		/* We have a 1 second up bound for responsiveness. */
-		if (jiffies_to_msecs(uksm_sleep_real) > MSEC_PER_SEC)
+		/* We have a 60 second up bound for responsiveness. */
+		if (jiffies_to_msecs(uksm_sleep_real) > MSEC_PER_SEC * 60)
 			uksm_sleep_real = msecs_to_jiffies(1000);
 	}
 
@@ -5077,7 +5077,7 @@
 	int err;
 
 	err = kstrtoul(buf, 10, &msecs);
-	if (err || msecs > MSEC_PER_SEC)
+	if (err || msecs > MSEC_PER_SEC * 60)
 		return -EINVAL;
 
 	uksm_sleep_jiffies = msecs_to_jiffies(msecs);
@@ -5751,7 +5751,7 @@
 	struct task_struct *uksm_thread;
 	int err;
 
-	uksm_sleep_jiffies = msecs_to_jiffies(100);
+	uksm_sleep_jiffies = msecs_to_jiffies(CONFIG_UKSM_SLEEP_MS);
 	uksm_sleep_saved = uksm_sleep_jiffies;
 
 	slot_tree_init();
